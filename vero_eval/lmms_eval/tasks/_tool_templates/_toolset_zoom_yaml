# Reusable ZOOM toolset (single source of truth).
#
# Bundles the tool selection + the modular system-prompt fragments for zooming.
# Include it from any tool-calling task yaml, alongside the dataset template:
#
#   include:
#     - <dataset_template>                       # e.g. visual_probe_hard.yaml
#     - ../_tool_templates/_toolset_zoom_yaml
#
# `metadata` deep-merges across includes (see lmms_eval/utils.py load_yaml_config),
# so a task may ALSO include an answer-protocol template (e.g.
# _answerproto_computer_use_yaml) and/or add its own metadata keys — the lists
# below are preserved, not overwritten.
#
# Read by the async_openai backend:
#   allowed_tools       -> which MCP tools the model is offered this task
#   system_prompt_files -> concatenated (in order) into the turn-0 system message;
#                          paths resolve against the vero_eval package root.
metadata:
  allowed_tools:
    - image_zoom_in_tool
  system_prompt_files:
    - prompts/tools/system_base.txt
    - prompts/tools/system_zoom.txt
