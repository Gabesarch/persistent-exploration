# Reusable COMBINED ZOOM+DRAW toolset (single source of truth).
#
# Offers BOTH the zoom tool and the full drawing toolset at once, with all three
# system-prompt fragments concatenated (base + zoom + draw). Include it from any
# tool-calling task yaml alongside the dataset template:
#
#   include:
#     - <dataset_template>                          # e.g. vstar_bench.yaml
#     - ../_tool_templates/_toolset_zoomdraw_yaml
#
# NOTE: do NOT instead include _toolset_zoom_yaml AND _toolset_draw_yaml together —
# metadata deep-merge is last-writer-wins for list values (see lmms_eval/utils.py
# _merge_yaml_config), so the second include would REPLACE allowed_tools rather than
# concatenate. This template lists the union explicitly so both sets are offered.
# Mask tools (draw_mask/draw_numbered_mask) are excluded (no mask_path source in eval).
metadata:
  allowed_tools:
    - image_zoom_in_tool
    - draw_boxes
    - draw_points
    - draw_lines
    - draw_texts
    - draw_polygons
  system_prompt_files:
    - prompts/tools/system_base_instruct.txt
    - prompts/tools/system_zoom.txt
    - prompts/tools/system_draw.txt
