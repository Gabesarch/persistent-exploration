# Reusable DRAWING toolset (single source of truth).
#
# Bundles the tool selection + the modular system-prompt fragments for drawing.
# Include it from any tool-calling task yaml, alongside the dataset template:
#
#   include:
#     - <dataset_template>                       # e.g. visual_probe_hard.yaml
#     - ../_tool_templates/_toolset_draw_yaml
#
# See _toolset_zoom_yaml for how metadata deep-merges across includes.
# Mask tools (draw_mask/draw_numbered_mask) are intentionally excluded: nothing
# in the eval produces a mask_path for them to consume.
metadata:
  allowed_tools:
    - draw_boxes
    - draw_points
    - draw_lines
    - draw_texts
    - draw_polygons
  system_prompt_files:
    - prompts/tools/system_base_thinking.txt
    - prompts/tools/system_draw.txt
