# Training-faithful DRAWING toolset for the Vero RL checkpoint.
#
# Mirrors _toolset_zoom_vero_yaml: passes the EXACT training Layer-A rules
# (system_vero_reasoning.txt) as the system message and preserves its trailing newline so the
# Layer-A / "# Tools" seam matches training (3 newlines, not 2). Include it from a task yaml
# alongside the dataset template.
#
# Pin the drawing tool surface to the current CountQA/CountBenchQA draw-points
# training run: only draw_points is offered, and its rendered schema matches
# vero2_scripts/config/tool_config/image_drawing_tools.yaml.
metadata:
  allowed_tools:
    - draw_points
  system_prompt_files:
    - prompts/tools/system_vero_reasoning.txt
  system_prompt_preserve_trailing_newline: true
  tool_schema_overrides:
    draw_points:
      description: "Draw one or more point markers on an image. Coordinates use 0-1000 scale where (0,0)=top-left and (1000,1000)=bottom-right. For a single point, pass [x, y]. For multiple points, pass [[x1, y1], [x2, y2], ...]. Example: draw_points(img_idx=0, points=[[500, 500], [600, 600]]) draws 2 points. For counting tasks, use this tool as a visual checklist: mark candidate target objects, inspect the returned annotated image, and continue from the latest img_idx if more objects remain. Do not redraw points already marked in earlier tool results. Use img_idx=0 for the original image only at the start; after a tool response says \"Registered image as img_idx N\", use img_idx=N to continue marking on the annotated image. Scan systematically by region, such as top-to-bottom or left-to-right, and mark only clearly visible target objects. Return exactly one valid JSON object in the tool_call block."
      parameters:
        type: object
        properties:
          img_idx:
            type: integer
            description: "Index of the image to draw on (0-based)."
          points:
            type: array
            description: "Either [x, y] for a single point, or [[x1, y1], [x2, y2], ...] for multiple points. Coordinates use 0-1000 scale."
          color:
            type: string
            description: "Color name for markers."
            default: "lime"
          radius:
            type: integer
            description: "Radius of the circle markers (0-1000, relative to image width)."
            default: 15
        required:
          - img_idx
          - points
