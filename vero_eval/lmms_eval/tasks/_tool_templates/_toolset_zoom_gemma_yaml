include: _toolset_zoom_vero_yaml
metadata:
  allowed_tools: [image_zoom_in_tool]
  system_prompt_files: [prompts/tools/system_gemma_zoom.txt]
  system_prompt_preserve_trailing_newline: false
  show_initial_image_index_hint: true
  restore_assistant_forced_prefill: false
  image_indexing: multi_index
  zoom_bbox_coordinate_order: yxyx
  tool_schema_overrides:
    image_zoom_in_tool:
      description: "Zoom in on a region of an available image using a bounding box and a short label."
      parameters:
        type: object
        properties:
          bbox_2d:
            type: array
            items:
              type: number
            minItems: 4
            maxItems: 4
            description: "[y1, x1, y2, x2] on a 1000x1000 grid relative to the selected image dimensions; y increases downward and x increases rightward."
          label:
            type: string
            description: "A short description of the region."
          img_idx:
            type: integer
            description: "Index of the selected image; the original is 0, and crop indices are stated in tool responses."
        required: [bbox_2d, label, img_idx]
