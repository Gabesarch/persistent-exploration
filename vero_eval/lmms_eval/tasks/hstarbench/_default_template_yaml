dataset_path: json
output_type: generate_until_agentic
doc_to_visual: !function utils.hstarbench_doc_to_visual
doc_to_text: !function utils.hstarbench_doc_to_text
doc_to_target: !function utils.hstarbench_doc_to_target
generation_kwargs:
  max_new_tokens: 1024
  temperature: 0
  top_p: 1.0
  do_sample: false
  max_agentic_steps: 10
process_results: !function utils.hstarbench_process_results
metric_list:
  - metric: hstarbench_success
    aggregation: !function utils.hstarbench_aggregate_success
    higher_is_better: true
lmms_eval_specific_kwargs:
  default:
    include_erp_for_mcp: false
metadata:
  version: 0.1
