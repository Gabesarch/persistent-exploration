dataset_path: loganbolton/sketchvlm-physics-ball-drop
test_split: train
output_type: generate_until
doc_to_visual: !function utils.ball_drop_doc_to_visual
doc_to_text: !function utils.ball_drop_doc_to_text
doc_to_target: "final_bucket_gt"

process_results: !function utils.ball_drop_process_results

metric_list:
  - metric: ball_drop_acc
    aggregation: mean
    higher_is_better: true

generation_kwargs:
  max_new_tokens: 16384

lmms_eval_specific_kwargs:
  default:
    pre_prompt: ""
    post_prompt: ""

metadata:
  version: 0.0
