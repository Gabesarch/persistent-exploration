{# Gemma 3 native turn/image tokens with an explicit Hermes JSON tool protocol.
   System instructions are folded into the first user turn, as in Google's template.
   Tool text and the following crop-image user message share one user turn. #}
{{- bos_token -}}
{%- set ns = namespace(role=none, first_user=true) -%}
{%- for message in messages -%}
  {%- if message['role'] != 'system' -%}
    {%- set role = 'model' if message['role'] == 'assistant' else 'user' -%}
    {%- if ns.role != role -%}
      {%- if ns.role is not none -%}{{- '<end_of_turn>\n' -}}{%- endif -%}
      {{- '<start_of_turn>' + role + '\n' -}}
      {%- set ns.role = role -%}
    {%- else -%}{{- '\n' -}}{%- endif -%}
    {%- if role == 'user' and ns.first_user -%}
      {%- for system in messages if system['role'] == 'system' -%}
        {%- if system['content'] is string -%}{{- system['content'] | trim -}}
        {%- else -%}{%- for part in system['content'] if part['type'] == 'text' -%}{{- part['text'] -}}{%- endfor -%}{%- endif -%}
        {{- '\n\n' -}}
      {%- endfor -%}
      {%- if tools -%}
        {{- '# Tools\n<tools>\n' -}}
        {%- for tool in tools -%}{{- tool | tojson -}}{{- '\n' -}}{%- endfor -%}
        {{- '</tools>\n\n' -}}
      {%- endif -%}
      {%- set ns.first_user = false -%}
    {%- endif -%}
    {%- if message['role'] == 'tool' -%}{{- '<tool_response>\n' -}}{%- endif -%}
    {%- if message['content'] is string -%}{{- message['content'] | trim -}}
    {%- elif message['content'] is iterable -%}
      {%- for item in message['content'] -%}
        {%- if item['type'] in ['image', 'image_url'] -%}{{- '<start_of_image>' -}}
        {# Match Google's text trimming: a leading newline after the image
           merges with the expanded image suffix and breaks vLLM span matching. #}
        {%- elif item['type'] == 'text' -%}{{- item['text'] | trim -}}{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- for call in message.get('tool_calls', []) -%}
      {{- '<tool_call>{"name":' + (call['function']['name'] | tojson) + ',"arguments":' -}}
      {%- if call['function']['arguments'] is string -%}{{- call['function']['arguments'] -}}
      {%- else -%}{{- call['function']['arguments'] | tojson -}}{%- endif -%}
      {{- '}</tool_call>' -}}
    {%- endfor -%}
    {%- if message['role'] == 'tool' -%}{{- '\n</tool_response>' -}}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if ns.role is not none -%}{{- '<end_of_turn>\n' -}}{%- endif -%}
{%- if add_generation_prompt -%}{{- '<start_of_turn>model\n' -}}{%- endif -%}
